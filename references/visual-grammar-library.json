{
  "libraryVersion": "6.0-mvp-1",
  "purpose": "Convert semantic relationships into visual sentences before art direction. Grammars are concept primitives, not slide templates.",
  "selectionPolicy": {
    "candidateCount": 3,
    "requireDistinctGestures": true,
    "requireSemanticEncoding": true,
    "requireHeroObject": true,
    "allowNoMotif": true
  },
  "scoreWeights": {
    "semantic_fit": 25,
    "relationship_encoding": 20,
    "hero_clarity": 15,
    "scale_contrast": 10,
    "color_function": 10,
    "whitespace_counterforce": 10,
    "neighbor_difference": 5,
    "execution_feasibility": 5
  },
  "grammars": [
    {
      "id": "ratio-proportional-fields",
      "signal": "ratio_composition",
      "name": "Proportional fields",
      "compatibleTopologies": ["comparable_metrics", "statistical_proof"],
      "visualGesture": "measure_and_combine",
      "heroKind": "proportional_field_system",
      "metaphor": "The canvas is divided by the stated weights and resolves into one combined output.",
      "scaleMode": "direct_proportion",
      "semanticEncoding": {"dataDimension": "weight", "visualChannel": "area_width", "relationship": "part_to_whole"},
      "colorRole": "data_encoding",
      "colorLevel": "medium",
      "whitespaceFunction": "separation_between_weighted_fields",
      "counterforce": "weighted_field_edges",
      "memorablePattern": "The audience can feel the ratios before reading the labels.",
      "doNot": ["equal-width metric columns", "pie chart", "decorative gradient strips"],
      "executionRisk": "low",
      "encodingStrength": "direct"
    },
    {
      "id": "ratio-weighted-convergence",
      "signal": "ratio_composition",
      "name": "Weighted convergence",
      "compatibleTopologies": ["comparable_metrics", "statistical_proof"],
      "visualGesture": "merge",
      "heroKind": "weighted_streams",
      "metaphor": "Inputs with visibly different weights converge into a single identity or decision.",
      "scaleMode": "weighted_stream_width",
      "semanticEncoding": {"dataDimension": "weight", "visualChannel": "flow_width", "relationship": "many_to_one"},
      "colorRole": "transition_encoding",
      "colorLevel": "medium_high",
      "whitespaceFunction": "trace_the_convergence_path",
      "counterforce": "convergence_node",
      "memorablePattern": "Several unequal streams become one resolved output.",
      "doNot": ["equal-width arrows", "generic Sankey styling", "mesh without a semantic merge"],
      "executionRisk": "medium",
      "encodingStrength": "transformed"
    },
    {
      "id": "ratio-weighted-orbit",
      "signal": "ratio_composition",
      "name": "Weighted tuning system",
      "compatibleTopologies": ["comparable_metrics"],
      "visualGesture": "weight_and_tune",
      "heroKind": "weighted_control_system",
      "metaphor": "A primary anchor is tuned by smaller influences until a final direction is locked.",
      "scaleMode": "weighted_radius_and_distance",
      "semanticEncoding": {"dataDimension": "influence", "visualChannel": "radius_distance", "relationship": "primary_with_modifiers"},
      "colorRole": "hierarchy_encoding",
      "colorLevel": "medium",
      "whitespaceFunction": "show_influence_distance",
      "counterforce": "final_locked_output",
      "memorablePattern": "Two smaller weights visibly alter the dominant anchor.",
      "doNot": ["planetary technology illustration", "decorative circles", "equal radii"],
      "executionRisk": "high",
      "encodingStrength": "metaphorical"
    },
    {
      "id": "process-progressive-compression",
      "signal": "process_transformation",
      "name": "Progressive compression",
      "compatibleTopologies": ["action_protocol", "three_stage_progression", "ordered_domains"],
      "visualGesture": "narrow_and_resolve",
      "heroKind": "converging_process_path",
      "metaphor": "A broad field of uncertainty narrows through each action into one executable artifact.",
      "scaleMode": "decreasing_uncertainty_increasing_resolution",
      "semanticEncoding": {"dataDimension": "uncertainty", "visualChannel": "width_density", "relationship": "progressive_reduction"},
      "colorRole": "resolution_progression",
      "colorLevel": "medium",
      "whitespaceFunction": "represent_discarded_possibilities",
      "counterforce": "resolved_final_artifact",
      "memorablePattern": "The final action expands as the uncertainty funnel closes.",
      "doNot": ["equal-size numbered nodes", "uniform timeline", "empty lower canvas"],
      "executionRisk": "low",
      "encodingStrength": "direct"
    },
    {
      "id": "process-artifact-morphology",
      "signal": "process_transformation",
      "name": "Artifact morphology",
      "compatibleTopologies": ["action_protocol", "ordered_domains"],
      "visualGesture": "transform_and_pass",
      "heroKind": "evolving_artifact",
      "metaphor": "One artifact changes form at every step while preserving what earlier steps contributed.",
      "scaleMode": "increasing_structure_decreasing_count",
      "semanticEncoding": {"dataDimension": "accumulated_output", "visualChannel": "shape_complexity", "relationship": "state_transformation"},
      "colorRole": "state_continuity",
      "colorLevel": "medium",
      "whitespaceFunction": "isolate_each_transformation",
      "counterforce": "single_continuous_artifact",
      "memorablePattern": "The final artifact visibly contains all previous states.",
      "doNot": ["six independent icons", "equal cards", "connector-only process"],
      "executionRisk": "medium",
      "encodingStrength": "transformed"
    },
    {
      "id": "process-unfolding-system",
      "signal": "process_transformation",
      "name": "Unfolding system",
      "compatibleTopologies": ["action_protocol", "ordered_domains"],
      "visualGesture": "unfold_and_integrate",
      "heroKind": "unfolding_map",
      "metaphor": "Each action opens another section of a system whose final panel integrates the method.",
      "scaleMode": "non_equal_panels_final_dominant",
      "semanticEncoding": {"dataDimension": "method_stage", "visualChannel": "panel_reveal", "relationship": "sequential_integration"},
      "colorRole": "stage_inheritance",
      "colorLevel": "medium_low",
      "whitespaceFunction": "define_the_unopened_field",
      "counterforce": "largest_final_panel",
      "memorablePattern": "The last fold absorbs the earlier actions into one usable system.",
      "doNot": ["travel-map styling", "accordion cards", "equal-size panels"],
      "executionRisk": "medium",
      "encodingStrength": "metaphorical"
    },
    {
      "id": "contrast-barrier-opening",
      "signal": "contrast_translation",
      "name": "Barrier and opening",
      "compatibleTopologies": ["ordered_domains", "reasoned_narrative", "three_peer_comparison"],
      "visualGesture": "block_then_open",
      "heroKind": "semantic_opening",
      "metaphor": "The rejected framing forms a barrier; the preferred framing cuts an opening through it.",
      "scaleMode": "preferred_statement_dominant_rejected_statement_compressed",
      "semanticEncoding": {"dataDimension": "accessibility", "visualChannel": "occlusion_open_space", "relationship": "blocked_vs_accessible"},
      "colorRole": "contrast_and_release",
      "colorLevel": "medium_high",
      "whitespaceFunction": "open_space_beyond_the_barrier",
      "counterforce": "dominant_preferred_statement",
      "memorablePattern": "The correct framing visibly opens the page.",
      "doNot": ["two equal cards", "red cross icon", "thin accent lines only"],
      "executionRisk": "low",
      "encodingStrength": "direct"
    },
    {
      "id": "contrast-overwrite-translation",
      "signal": "contrast_translation",
      "name": "Overwrite translation",
      "compatibleTopologies": ["ordered_domains", "reasoned_narrative"],
      "visualGesture": "overwrite",
      "heroKind": "translation_band",
      "metaphor": "A strong translation action rewrites specialist language into an answerable statement while leaving the old wording as evidence.",
      "scaleMode": "replacement_statement_as_object",
      "semanticEncoding": {"dataDimension": "framing", "visualChannel": "layer_priority", "relationship": "old_to_new"},
      "colorRole": "warm_to_cool_translation",
      "colorLevel": "medium_high",
      "whitespaceFunction": "expose_the_rewrite_action",
      "counterforce": "cross_canvas_translation_band",
      "memorablePattern": "The new statement physically overwrites the old one.",
      "doNot": ["before-after cards", "decorative ribbon", "illegible crossed text"],
      "executionRisk": "medium",
      "encodingStrength": "transformed"
    },
    {
      "id": "contrast-strike-replace",
      "signal": "contrast_translation",
      "name": "Strike and replace",
      "compatibleTopologies": ["ordered_domains", "reasoned_narrative"],
      "visualGesture": "strike_and_replace",
      "heroKind": "replacement_gesture",
      "metaphor": "The obsolete question is interrupted and the useful question emerges from the break.",
      "scaleMode": "gesture_spans_majority_new_statement_dominant",
      "semanticEncoding": {"dataDimension": "decision", "visualChannel": "directional_interruption", "relationship": "reject_then_replace"},
      "colorRole": "single_high_energy_interruption",
      "colorLevel": "high",
      "whitespaceFunction": "amplify_the_interruption",
      "counterforce": "new_statement_at_break_point",
      "memorablePattern": "One decisive gesture removes the wrong question.",
      "doNot": ["red X icon", "hand-drawn annotation style", "multiple decorative marks"],
      "executionRisk": "medium",
      "encodingStrength": "direct"
    },
    {
      "id": "thesis-typographic-field",
      "signal": "thesis_emphasis",
      "name": "Typographic field",
      "compatibleTopologies": ["single_thesis", "reasoned_narrative", "decisive_kpi"],
      "visualGesture": "occupy_and_anchor",
      "heroKind": "overscale_statement",
      "metaphor": "The claim becomes the dominant physical field and supporting evidence occupies its negative space.",
      "scaleMode": "title_as_object",
      "semanticEncoding": {"dataDimension": "claim_priority", "visualChannel": "typographic_scale", "relationship": "claim_over_support"},
      "colorRole": "chromatic_keyword_or_neutral_field",
      "colorLevel": "medium",
      "whitespaceFunction": "shape_the_claim_silhouette",
      "counterforce": "overscale_statement",
      "memorablePattern": "The audience remembers the page as one physical sentence.",
      "doNot": ["header plus body", "centered slogan", "tiny supporting accent"],
      "executionRisk": "low",
      "encodingStrength": "direct"
    },
    {
      "id": "thesis-semantic-axis",
      "signal": "thesis_emphasis",
      "name": "Semantic axis",
      "compatibleTopologies": ["reasoned_narrative", "comparative_proof", "decisive_kpi"],
      "visualGesture": "pull_apart",
      "heroKind": "tension_axis",
      "metaphor": "Two ends of the argument create a visible axis and the conclusion occupies the decisive position.",
      "scaleMode": "asymmetric_poles",
      "semanticEncoding": {"dataDimension": "argument_tension", "visualChannel": "position_distance", "relationship": "opposition_with_resolution"},
      "colorRole": "polar_contrast",
      "colorLevel": "medium",
      "whitespaceFunction": "make_the_distance_meaningful",
      "counterforce": "resolved_endpoint",
      "memorablePattern": "The conclusion visibly wins the spatial argument.",
      "doNot": ["balanced two-column comparison", "equal poles", "decorative center line"],
      "executionRisk": "medium",
      "encodingStrength": "transformed"
    },
    {
      "id": "thesis-evidence-carveout",
      "signal": "thesis_emphasis",
      "name": "Evidence carveout",
      "compatibleTopologies": ["reasoned_narrative", "decisive_kpi", "statistical_proof"],
      "visualGesture": "carve_and_reveal",
      "heroKind": "evidence_window",
      "metaphor": "The headline field is carved open to reveal the one proof that changes the decision.",
      "scaleMode": "headline_field_with_dominant_evidence_cutout",
      "semanticEncoding": {"dataDimension": "proof_priority", "visualChannel": "figure_ground", "relationship": "claim_reveals_evidence"},
      "colorRole": "evidence_highlight",
      "colorLevel": "medium_high",
      "whitespaceFunction": "become_the_evidence_window",
      "counterforce": "revealed_proof",
      "memorablePattern": "The proof appears as a deliberate opening inside the claim.",
      "doNot": ["floating evidence card", "soft shadow container", "random cutout"],
      "executionRisk": "medium",
      "encodingStrength": "metaphorical"
    }
  ]
}
